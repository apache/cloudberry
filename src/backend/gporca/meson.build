gporca = static_library('gporca',
  orca_sources,
  include_directories: [orca_inc, postgres_inc],
  dependencies: [backend_code, xerces],
  cpp_args: orca_cpp_args,
  # configure.ac pins C++14 by appending -std=c++14 to CXX itself
  # (config/ax_cxx_compile_stdcxx.m4); meson expresses it as an option.
  override_options: ['cpp_std=c++14'],
  kwargs: internal_lib_args,
)
backend_link_with += gporca
