#
# ORCA is built as one static library and linked whole into the backend. The
# Makefiles keep 34 near-identical leaf files that only emit objfiles.txt; in
# meson the whole tree collapses to this single file.

orca_inc = include_directories(
  'libgpos/include',
  'libgpopt/include',
  'libnaucrates/include',
  'libgpdbcost/include',
)

# gporca.mk: do not omit the frame pointer (used for backtraces even in
# release builds). Linux tolerates the strict triple; Apple clang emits many
# more diagnostics under it, so it is dropped there -- same split as the .mk.
orca_cpp_args = ['-fno-omit-frame-pointer']
if host_machine.system() != 'darwin'
  orca_cpp_args += ['-Werror', '-Wextra', '-Wpedantic']
endif

