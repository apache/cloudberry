-- At least the QE that raises the prepare error has finished its phase;
-- peers can be canceled before they finish and need not publish a time.
SELECT sum(total_vacuum_time) >= 1000 AND bool_and(vacuum_count = 0) AS aborted_phase_timed FROM gp_stat_all_tables WHERE relname = 'ao_phase_time' AND gp_segment_id > -1;
 aborted_phase_timed 
---------------------
 t                   
(1 row)
CREATE TEMP TABLE ao_time_before AS SELECT gp_segment_id AS content, total_vacuum_time FROM gp_stat_all_tables WHERE relname = 'ao_phase_time' AND gp_segment_id > -1 DISTRIBUTED BY (content);
CREATE 3
1: VACUUM ao_phase_time;
VACUUM
SELECT bool_and(s.vacuum_count = 1 AND s.total_vacuum_time >= b.total_vacuum_time) AS completed_once FROM gp_stat_all_tables s JOIN ao_time_before b ON s.gp_segment_id = b.content WHERE s.relname = 'ao_phase_time';
 completed_once 
----------------
 t              
(1 row)
SELECT count(*) = 500 AS rows_preserved FROM ao_phase_time;
 rows_preserved 
