-- Both progress summaries sum consumed delay across workers, including
-- replicated copies. Configure utility sessions directly: timing is unsync.
CREATE TABLE progress_delay_heap (a int, padding text) WITH (autovacuum_enabled=false, fillfactor=10) DISTRIBUTED REPLICATED;
CREATE
INSERT INTO progress_delay_heap SELECT g, repeat('x', 100) FROM generate_series(1, 1000) g;
INSERT 1000
CREATE TABLE progress_delay_ao (a int) WITH (appendonly=true) DISTRIBUTED REPLICATED;
CREATE
INSERT INTO progress_delay_ao SELECT generate_series(1, 1000);
INSERT 1000
DELETE FROM progress_delay_ao WHERE a % 2 = 0;
DELETE 500
