-- Counts and elapsed times must use the same coordinator ANALYZE record.
-- QE sampling records auto-analyze as manual ANALYZE.
SET gp_autostats_mode = none;
SET
CREATE TABLE analyze_time_hash (a int) WITH (autovacuum_enabled = false) DISTRIBUTED BY (a);
CREATE
CREATE TABLE analyze_time_repl (a int) WITH (autovacuum_enabled = false) DISTRIBUTED REPLICATED;
CREATE
INSERT INTO analyze_time_hash SELECT generate_series(1, 50000);
INSERT 50000
INSERT INTO analyze_time_repl SELECT generate_series(1, 50000);
INSERT 50000
ANALYZE analyze_time_hash;
ANALYZE
ANALYZE analyze_time_repl;
ANALYZE
SELECT count(*) = 2 AND bool_and(s.analyze_count = 1 AND s.autoanalyze_count = 0 AND s.total_analyze_time > 0 AND s.total_autoanalyze_time = 0 AND s.total_analyze_time = q.total_analyze_time) AS manual_times_match FROM gp_stat_all_tables_summary s JOIN pg_stat_all_tables q USING (relid) WHERE s.relname IN ('analyze_time_hash', 'analyze_time_repl');
 manual_times_match 
--------------------
 t                  
(1 row)

-- Start a fresh interval, then let an actual coordinator autovacuum worker
-- analyze both tables. No explicit ANALYZE may contribute to this interval.
SELECT pg_stat_reset_single_table_counters('analyze_time_hash'::regclass);
 pg_stat_reset_single_table_counters 
-------------------------------------
                                     
(1 row)
SELECT pg_stat_reset_single_table_counters('analyze_time_repl'::regclass);
 pg_stat_reset_single_table_counters 
-------------------------------------
                                     
(1 row)
ALTER TABLE analyze_time_hash SET (autovacuum_enabled = true, autovacuum_analyze_threshold = 100, autovacuum_analyze_scale_factor = 0);
ALTER
ALTER TABLE analyze_time_repl SET (autovacuum_enabled = true, autovacuum_analyze_threshold = 100, autovacuum_analyze_scale_factor = 0);
ALTER
ALTER SYSTEM SET autovacuum = on;
ALTER
ALTER SYSTEM SET autovacuum_naptime = '1s';
ALTER
SELECT pg_reload_conf();
 pg_reload_conf 
----------------
 t              
(1 row)
INSERT INTO analyze_time_hash SELECT generate_series(50001, 60000);
INSERT 10000
INSERT INTO analyze_time_repl SELECT generate_series(50001, 60000);
INSERT 10000
SELECT gp_stat_force_next_flush();
 gp_stat_force_next_flush 
--------------------------
                          
(1 row)
CREATE FUNCTION wait_for_analyze_times() RETURNS bool LANGUAGE plpgsql AS $$ BEGIN FOR i IN 1..600 LOOP PERFORM pg_stat_clear_snapshot(); /* in func */ IF (SELECT count(*) = 2 FROM pg_stat_all_tables WHERE relname IN ('analyze_time_hash', 'analyze_time_repl') AND autoanalyze_count > 0 AND total_autoanalyze_time > 0) THEN RETURN true; /* in func */ END IF; /* in func */ PERFORM pg_sleep(0.1); /* in func */ END LOOP; /* in func */ RAISE EXCEPTION 'timed out waiting for auto-analyze'; /* in func */ END; /* in func */ $$;
CREATE
SELECT wait_for_analyze_times();
 wait_for_analyze_times 
------------------------
 t                      
(1 row)
SELECT count(*) = 2 AND bool_and(s.analyze_count = 0 AND s.autoanalyze_count > 0 AND s.total_analyze_time = 0 AND s.total_autoanalyze_time > 0 AND s.total_autoanalyze_time = q.total_autoanalyze_time) AS auto_times_match FROM gp_stat_all_tables_summary s JOIN pg_stat_all_tables q USING (relid) WHERE s.relname IN ('analyze_time_hash', 'analyze_time_repl');
 auto_times_match 
------------------
 t                
(1 row)
DROP FUNCTION wait_for_analyze_times();
DROP
DROP TABLE analyze_time_hash, analyze_time_repl;
DROP
ALTER SYSTEM RESET autovacuum;
ALTER
ALTER SYSTEM RESET autovacuum_naptime;
ALTER
SELECT pg_reload_conf();
