-- Distributed log truncation must preserve old standby distributed snapshots.
-- A query that already passed snapshot validation must still detect a
-- TRUNCATE replayed before it reads its tuples.
--
-- start_matchsubs
-- m/^ERROR:  canceling statement due to conflict with recovery/
-- s/^ERROR:  canceling statement due to conflict with recovery.*$/ERROR:  canceling statement due to conflict with recovery/
-- end_matchsubs

1: create table hs_dlog_conf(a int, b int) distributed by (a);
CREATE
1: create table hs_dlog_sync(a int) distributed by (a);
CREATE

-- Take a distributed snapshot before the INSERT, then let the mirrors take
-- their local snapshots after it. Pause after snapshot validation, before
-- the executor reads the table.
-1S: select gp_inject_fault('select_after_qd_create_snapshot', 'suspend', dbid) from gp_segment_configuration where content = -1 and role = 'm';
 gp_inject_fault 
