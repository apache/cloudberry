(24 rows)

reset enable_answer_query_using_materialized_views;
drop schema aqumv_rw cascade;
NOTICE:  drop cascades to 6 other objects
DETAIL:  drop cascades to table rw_t1
drop cascades to materialized view rw_mv_grouped
drop cascades to table rw_ta
drop cascades to table rw_tb
drop cascades to materialized view rw_mv_join
drop cascades to materialized view rw_mv_join_intlist
