TO_CHAR(COALESCE(MIN(floor(ow_sale.cn+ow_sale.cn)) OVER(order by ow_sale.ord, ow_sale.pn desc,ow_sale.pn asc rows 0 preceding ),0),'99999999.9999999'),
TO_CHAR(COALESCE(PERCENT_RANK() OVER(win3),0),'99999999.9999999'),
