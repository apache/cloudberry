 400 |    1 | 50 |  1 |          .0000000 |          .5000000 |         1.0000000 |         1.0000000 |         1.0000000 |          .4166667
 100 |    1 | 20 |  1 |          .0000000 |          .5000000 |         1.0000000 |         1.0000000 |         1.0000000 |          .4166667
 200 |    1 | 10 |  1 |          .0000000 |          .5000000 |         1.0000000 |         1.0000000 |         1.0000000 |          .4166667
 100 | 1100 | 40 |  2 |          .0000000 |         1.0000000 |         1.0000000 |         2.0000000 |          .0000000 |          .5833333
 400 |    1 | 50 |  2 |          .0000000 |         1.0000000 |         1.0000000 |         2.0000000 |          .0000000 |          .5833333
 200 |    1 | 40 |  3 |          .0000000 |         1.0000000 |         1.0000000 |         2.0000000 |          .0000000 |          .8333333
 600 |   12 | 30 |  3 |          .0000000 |         1.0000000 |         3.0000000 |         1.0000000 |          .0000000 |          .8333333
 500 |   12 | 30 |  3 |          .0000000 |         1.0000000 |         1.0000000 |         2.0000000 |          .0000000 |          .8333333
 700 |    1 | 40 |  4 |          .0000000 |         1.0000000 |         4.0000000 |         1.0000000 |          .0000000 |         1.0000000
 800 |    1 | 40 |  4 |          .0000000 |         1.0000000 |         4.0000000 |         1.0000000 |          .0000000 |         1.0000000
