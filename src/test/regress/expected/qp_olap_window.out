drop table if exists tab12773_vendor;
NOTICE:  table "tab12773_vendor" does not exist, skipping
create table tab12773_vendor 
(
	vn int not null,
	vname text not null,
	vloc text,
	
	primary key (vn)
	
) distributed by (vn);
drop table if exists tab12773_product;
NOTICE:  table "tab12773_product" does not exist, skipping
create table tab12773_product 
(
	pn int not null,
	pname text not null,
	pcolor text,
	
	primary key (pn)
	
) distributed by (pn);
drop table if exists tab12773_sale_ord;
NOTICE:  table "tab12773_sale_ord" does not exist, skipping
create table tab12773_sale_ord
(
        ord int not null,
	cn int not null,
	vn int not null,
	pn int not null,
	dt date not null,
	qty int not null,
	prc float not null,
	
	primary key (cn, vn, pn)
	
) distributed by (cn,vn,pn);
