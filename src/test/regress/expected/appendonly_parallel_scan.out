--
-- Joins and aggregates
--
-- A parallel hash join of two parallel scans.
explain (costs off)
select count(*), sum(x.a) from filt x join filt y on x.a = y.a;
                                   QUERY PLAN                                    
---------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 12:1  (slice1; segments: 12)
         ->  Partial Aggregate
               ->  Parallel Hash Join
                     Hash Cond: (x.a = y.a)
                     ->  Redistribute Motion 12:12  (slice2; segments: 12)
                           Hash Key: x.a
                           Hash Module: 3
                           ->  Parallel Seq Scan on filt x
                     ->  Parallel Hash
                           ->  Redistribute Motion 12:12  (slice3; segments: 12)
                                 Hash Key: y.a
                                 Hash Module: 3
                                 ->  Parallel Seq Scan on filt y
 Optimizer: Postgres query optimizer
(15 rows)

select count(*), sum(x.a) from filt x join filt y on x.a = y.a;
 count  |    sum     
--------+------------
 100000 | 5000050000
(1 row)

-- Partial and final aggregation.
explain (costs off)
select a % 7 as g, count(*), sum(a) from filt group by 1 order by 1;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Gather Motion 12:1  (slice1; segments: 12)
   Merge Key: ((a % 7))
   ->  Sort
         Sort Key: ((a % 7))
         ->  Finalize HashAggregate
               Group Key: ((a % 7))
               ->  Redistribute Motion 12:12  (slice2; segments: 12)
                     Hash Key: ((a % 7))
                     Hash Module: 3
                     ->  Partial HashAggregate
                           Group Key: (a % 7)
                           ->  Parallel Seq Scan on filt
 Optimizer: Postgres query optimizer
(13 rows)

