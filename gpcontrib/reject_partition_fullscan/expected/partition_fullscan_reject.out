-- ==============================
-- Test 8: Threshold mode
-- ==============================
SET partition_fullscan_threshold = 2;
-- Pruned to 2 partitions, within threshold, should pass
SELECT * FROM pfr_test
	WHERE dt >= '2025-01-01' AND dt < '2025-07-01';
NOTICE:  One or more columns in the following table(s) do not have statistics: pfr_test
HINT:  For non-partitioned tables, run analyze <table_name>(<column_list>). For partitioned tables, run analyze rootpartition <table_name>(<column_list>). See log for columns missing statistics.
 id | dt | val 
----+----+-----
(0 rows)

-- All 3 partitions exceed threshold of 2, should reject
SELECT * FROM pfr_test;
NOTICE:  One or more columns in the following table(s) do not have statistics: pfr_test
HINT:  For non-partitioned tables, run analyze <table_name>(<column_list>). For partitioned tables, run analyze rootpartition <table_name>(<column_list>). See log for columns missing statistics.
ERROR:  partitioned table "public.pfr_test" full partition scan is not allowed, 3 partitions would be scanned
HINT:  Add a WHERE clause on the partition key to enable partition pruning.
SET partition_fullscan_threshold = 0;
-- ==============================
-- Test 9: Prepared statement with parameter (exemption)
-- ==============================
PREPARE pfr_q AS SELECT * FROM pfr_test WHERE dt = $1;
EXECUTE pfr_q('2025-02-01');
NOTICE:  One or more columns in the following table(s) do not have statistics: pfr_test
HINT:  For non-partitioned tables, run analyze <table_name>(<column_list>). For partitioned tables, run analyze rootpartition <table_name>(<column_list>). See log for columns missing statistics.
 id | dt | val 
----+----+-----
(0 rows)

DEALLOCATE pfr_q;
-- ==============================
-- Test 10: UPDATE/DELETE without WHERE - should reject
-- ==============================
UPDATE pfr_test SET val = 'y';
ERROR:  partitioned table "public.pfr_test" full partition scan is not allowed, 3 partitions would be scanned
HINT:  Add a WHERE clause on the partition key to enable partition pruning.
DELETE FROM pfr_test;
ERROR:  partitioned table "public.pfr_test" full partition scan is not allowed, 3 partitions would be scanned
HINT:  Add a WHERE clause on the partition key to enable partition pruning.
-- UPDATE/DELETE with partition key - should pass
UPDATE pfr_test SET val = 'y' WHERE dt = '2025-02-01';
DELETE FROM pfr_test WHERE dt = '2025-02-01';
-- ==============================
-- Test 11: Subquery containing partitioned table
-- ==============================
SELECT * FROM (SELECT * FROM pfr_test) sub;
NOTICE:  One or more columns in the following table(s) do not have statistics: pfr_test
HINT:  For non-partitioned tables, run analyze <table_name>(<column_list>). For partitioned tables, run analyze rootpartition <table_name>(<column_list>). See log for columns missing statistics.
ERROR:  partitioned table "public.pfr_test" full partition scan is not allowed, 3 partitions would be scanned
HINT:  Add a WHERE clause on the partition key to enable partition pruning.
-- ==============================
-- Test 12: threshold=0 partial scan must NOT be rejected (issue #2342)
--   Plan-time static pruning keeps 2 of 3 partitions under the Postgres
--   planner, producing an Append with no PartitionPruneInfo.  This is a
--   legitimate partial scan and must pass, not be rejected as a full scan.
-- ==============================
SET optimizer = off;
SET partition_fullscan_threshold = 0;
-- keeps p1 and p2, prunes p3 -> partial scan, should pass
SELECT * FROM pfr_test
	WHERE dt >= '2025-01-01' AND dt < '2025-07-01';
 id | dt | val 
----+----+-----
(0 rows)

-- all 3 partitions -> true full scan, should still reject
SELECT count(*) FROM pfr_test;
ERROR:  partitioned table "public.pfr_test" full partition scan is not allowed, 3 partitions would be scanned
HINT:  Add a WHERE clause on the partition key to enable partition pruning.
-- ==============================
-- Test 13: ORCA dynamic scan full scan must be rejected (issue #2342)
--   ORCA leaves relkind unset on the dynamic scan RTE; detection must look
--   up relkind from the catalog, otherwise full scans slip through.
-- ==============================
SET optimizer = on;
-- unfiltered full scan under ORCA -> should reject
SELECT count(*) FROM pfr_test;
NOTICE:  One or more columns in the following table(s) do not have statistics: pfr_test
HINT:  For non-partitioned tables, run analyze <table_name>(<column_list>). For partitioned tables, run analyze rootpartition <table_name>(<column_list>). See log for columns missing statistics.
ERROR:  partitioned table "public.pfr_test" full partition scan is not allowed, 3 partitions would be scanned
HINT:  Add a WHERE clause on the partition key to enable partition pruning.
-- pruning predicate keeping a single partition -> should pass
SELECT * FROM pfr_test WHERE dt = '2025-02-01';
NOTICE:  One or more columns in the following table(s) do not have statistics: pfr_test
HINT:  For non-partitioned tables, run analyze <table_name>(<column_list>). For partitioned tables, run analyze rootpartition <table_name>(<column_list>). See log for columns missing statistics.
 id | dt | val 
----+----+-----
(0 rows)

SET optimizer = off;
SET partition_fullscan_threshold = 0;
-- ==============================
-- Cleanup
-- ==============================
DROP TABLE pfr_test;
DROP TABLE pfr_single;
RESET reject_partition_fullscan;
RESET partition_fullscan_threshold;
RESET enable_partition_pruning;
RESET optimizer;
