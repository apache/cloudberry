-- errors_scan: storage errors seen from a scan, and type mismatches.
--
-- Two shapes of failure live here.  The storage ones - a path that is not
-- there, a bucket that is not there, credentials that are wrong, an endpoint
-- nothing answers - quote paths and lance's own wording, so they go through
-- capture() and only the category is compared.  The type ones are the opposite:
-- the message is the point, so they go through message(), which returns the
-- wording without the segment suffix a QE error arrives with.
\pset format unaligned
DO $$
BEGIN
  EXECUTE format('CREATE SERVER errs_files FOREIGN DATA WRAPPER lance_fdw OPTIONS (base_uri %L)',
                 current_setting('regress.fixture_dir'));
END
$$;
-- A local path that is not there.
CREATE SERVER errs_missing FOREIGN DATA WRAPPER lance_fdw
  OPTIONS (base_uri 'file:///lance_fdw_no_such_directory');
CREATE FOREIGN TABLE lance_feature.errs_missing_t (id integer, v text)
  SERVER errs_missing OPTIONS (uri 'nope.lance');
SELECT lance_feature.capture($$SELECT * FROM lance_feature.errs_missing_t$$) AS missing_path;
missing_path
lance error
(1 row)
SELECT lance_feature.capture($$SELECT count(*) FROM lance_feature.errs_missing_t$$) AS missing_path_count;
missing_path_count
lance error
(1 row)
DO $$
BEGIN
  -- a bucket that does not exist, with working credentials
  EXECUTE format('CREATE SERVER errs_badbucket FOREIGN DATA WRAPPER lance_fdw '
                 'OPTIONS (base_uri %L, aws_endpoint %L, aws_region %L, allow_http %L)',
                 's3://lance-fdw-no-such-bucket/fixtures',
                 current_setting('regress.s3_endpoint'),
                 current_setting('regress.s3_region'), 'true');
  EXECUTE format('CREATE USER MAPPING FOR PUBLIC SERVER errs_badbucket '
                 'OPTIONS (aws_access_key_id %L, aws_secret_access_key %L)',
                 current_setting('regress.s3_key'),
                 current_setting('regress.s3_secret'));
  -- the real bucket, with credentials that are not
  EXECUTE format('CREATE SERVER errs_badcreds FOREIGN DATA WRAPPER lance_fdw '
                 'OPTIONS (base_uri %L, aws_endpoint %L, aws_region %L, allow_http %L)',
                 's3://' || current_setting('regress.s3_bucket') || '/fixtures',
                 current_setting('regress.s3_endpoint'),
                 current_setting('regress.s3_region'), 'true');
  EXECUTE 'CREATE USER MAPPING FOR PUBLIC SERVER errs_badcreds '
          'OPTIONS (aws_access_key_id ''wrong-key'', aws_secret_access_key ''wrong-secret'')';
  -- an endpoint nothing listens on; object_store retries a refused connection
  -- with backoff, so this one takes a few seconds to give up
  EXECUTE format('CREATE SERVER errs_badendpoint FOREIGN DATA WRAPPER lance_fdw '
                 'OPTIONS (base_uri %L, aws_endpoint %L, aws_region %L, allow_http %L)',
                 's3://' || current_setting('regress.s3_bucket') || '/fixtures',
                 'http://127.0.0.1:1',
                 current_setting('regress.s3_region'), 'true');
  EXECUTE format('CREATE USER MAPPING FOR PUBLIC SERVER errs_badendpoint '
                 'OPTIONS (aws_access_key_id %L, aws_secret_access_key %L)',
                 current_setting('regress.s3_key'),
                 current_setting('regress.s3_secret'));
END
$$;
CREATE FOREIGN TABLE lance_feature.errs_badbucket_t (id integer, v text, n bigint)
  SERVER errs_badbucket OPTIONS (uri 'frag_3.lance');
CREATE FOREIGN TABLE lance_feature.errs_badcreds_t (id integer, v text, n bigint)
  SERVER errs_badcreds OPTIONS (uri 'frag_3.lance');
CREATE FOREIGN TABLE lance_feature.errs_badendpoint_t (id integer, v text, n bigint)
  SERVER errs_badendpoint OPTIONS (uri 'frag_3.lance');
SELECT lance_feature.capture($$SELECT * FROM lance_feature.errs_badbucket_t$$) AS missing_bucket;
missing_bucket
lance error
(1 row)
SELECT lance_feature.capture($$SELECT * FROM lance_feature.errs_badcreds_t$$) AS bad_credentials;
bad_credentials
lance error
(1 row)
SELECT lance_feature.capture($$SELECT * FROM lance_feature.errs_badendpoint_t$$) AS unreachable_endpoint;
unreachable_endpoint
lance error
(1 row)
-- A version the dataset does not have.
CREATE FOREIGN TABLE lance_feature.errs_badversion (id integer, v text, n bigint)
  SERVER errs_files OPTIONS (uri 'frag_3.lance', version '999');
SELECT lance_feature.capture($$SELECT * FROM lance_feature.errs_badversion$$) AS missing_version;
missing_version
lance error
(1 row)
-- Type checking.  Every message names the column, the Arrow format
-- string and the PostgreSQL type, because those three are what it takes to fix
-- the table definition.
CREATE FOREIGN TABLE lance_feature.errs_narrow (c_int64 integer)
  SERVER errs_files OPTIONS (uri 'types_all.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_narrow$$) AS int64_into_integer;
int64_into_integer
lance_fdw: column "c_int64": Lance type "l" (int64) cannot be read as integer
(1 row)
CREATE FOREIGN TABLE lance_feature.errs_uint32 (c_uint32 integer)
  SERVER errs_files OPTIONS (uri 'types_all.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_uint32$$) AS uint32_into_integer;
uint32_into_integer
lance_fdw: column "c_uint32": Lance type "I" (uint32) cannot be read as integer
(1 row)
CREATE FOREIGN TABLE lance_feature.errs_text_int (c_utf8 integer)
  SERVER errs_files OPTIONS (uri 'types_all.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_text_int$$) AS utf8_into_integer;
utf8_into_integer
lance_fdw: column "c_utf8": Lance type "u" (string) cannot be read as integer
(1 row)
CREATE FOREIGN TABLE lance_feature.errs_double_real (c_float64 real)
  SERVER errs_files OPTIONS (uri 'types_all.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_double_real$$) AS float64_into_real;
float64_into_real
lance_fdw: column "c_float64": Lance type "g" (double) cannot be read as real
(1 row)
CREATE FOREIGN TABLE lance_feature.errs_varchar (c_utf8 varchar(4))
  SERVER errs_files OPTIONS (uri 'types_all.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_varchar$$) AS utf8_into_varchar4;
utf8_into_varchar4
lance_fdw: column "c_utf8": Lance type "u" (string) cannot be read as character varying(4)
(1 row)
-- A list-shaped type read into something that is not an array of its element.
CREATE FOREIGN TABLE lance_feature.errs_fsl (c_fsl_f32_4 text)
  SERVER errs_files OPTIONS (uri 'types_all.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_fsl$$) AS fsl_into_text;
fsl_into_text
lance_fdw: column "c_fsl_f32_4": Lance type "+w:4" (fixed_size_list) cannot be read as text
(1 row)
-- A B-tier type, which no declaration makes readable.
CREATE FOREIGN TABLE lance_feature.errs_struct (c_struct text)
  SERVER errs_files OPTIONS (uri 'types_b.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_struct$$) AS struct_into_text;
struct_into_text
lance_fdw: column "c_struct": Lance type "+s" (struct) cannot be read as text
(1 row)
CREATE FOREIGN TABLE lance_feature.errs_uint64 (c_uint64 bigint)
  SERVER errs_files OPTIONS (uri 'types_b.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_uint64$$) AS uint64_into_bigint;
uint64_into_bigint
lance_fdw: column "c_uint64": Lance type "L" (uint64) is not supported and cannot be read as bigint
(1 row)
-- A column the dataset does not have at all, refused by name before anything
-- is read.
CREATE FOREIGN TABLE lance_feature.errs_nocolumn (id integer, no_such_column text)
  SERVER errs_files OPTIONS (uri 'frag_3.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_nocolumn$$) AS unknown_column;
unknown_column
lance_fdw: column "no_such_column": the dataset has no such column
(1 row)
-- A column that is only in the way is not read, so the same table works as
-- long as nothing selects it.
SELECT count(*) AS rows_without_it FROM lance_feature.errs_nocolumn;
rows_without_it
15
(1 row)
-- After all of that the same backend still reads a real dataset.
CREATE FOREIGN TABLE lance_feature.errs_ok (id integer, v text, n bigint)
  SERVER errs_files OPTIONS (uri 'frag_3.lance');
SELECT count(*) AS rows, sum(n) AS sum_n FROM lance_feature.errs_ok;
rows|sum_n
15|1015
(1 row)
-- A dataset with no fragments still has a schema, and a declaration that does
-- not match it is wrong whether or not there is a row to prove it on: nothing
-- opens a stream here, so the check has to come from the dataset's own schema.
-- Both execution modes reach it by a different path - the
-- coordinator on behalf of every segment, or one process reading everything.
CREATE FOREIGN TABLE lance_feature.errs_empty_badtype (id text)
  SERVER errs_files OPTIONS (uri 'empty.lance');
SELECT lance_feature.message($$SELECT id FROM lance_feature.errs_empty_badtype$$) AS empty_bad_type;
empty_bad_type
lance_fdw: column "id": Lance type "i" (int32) cannot be read as text
(1 row)
CREATE FOREIGN TABLE lance_feature.errs_empty_nocolumn (id integer, no_such_column text)
  SERVER errs_files OPTIONS (uri 'empty.lance');
SELECT lance_feature.message($$SELECT * FROM lance_feature.errs_empty_nocolumn$$) AS empty_unknown_column;
empty_unknown_column
lance_fdw: column "no_such_column": the dataset has no such column
(1 row)
CREATE FOREIGN TABLE lance_feature.errs_empty_coord (id text)
  SERVER errs_files OPTIONS (uri 'empty.lance', mpp_execute 'coordinator');
SELECT lance_feature.message($$SELECT id FROM lance_feature.errs_empty_coord$$) AS empty_bad_type_coordinator;
empty_bad_type_coordinator
lance_fdw: column "id": Lance type "i" (int32) cannot be read as text
(1 row)
-- A B-tier column on a dataset with no fragments at all: types_b.lance has
-- rows, so its refusal comes from the stream converter and would still happen
-- with the schema check gone.  empty_b.lance is zero rows and zero fragments,
-- so only the dataset schema can refuse it.
CREATE FOREIGN TABLE lance_feature.errs_empty_btier (id integer, c_uint64 bigint)
  SERVER errs_files OPTIONS (uri 'empty_b.lance');
SELECT lance_feature.message($$SELECT c_uint64 FROM lance_feature.errs_empty_btier$$) AS empty_btier;
empty_btier
lance_fdw: column "c_uint64": Lance type "L" (uint64) is not supported and cannot be read as bigint
(1 row)
CREATE FOREIGN TABLE lance_feature.errs_empty_btier_coord (id integer, c_uint64 bigint)
  SERVER errs_files OPTIONS (uri 'empty_b.lance', mpp_execute 'coordinator');
SELECT lance_feature.message($$SELECT c_uint64 FROM lance_feature.errs_empty_btier_coord$$) AS empty_btier_coordinator;
empty_btier_coordinator
lance_fdw: column "c_uint64": Lance type "L" (uint64) is not supported and cannot be read as bigint
(1 row)
-- The A-tier column of the same empty dataset still reads its zero rows.
SELECT count(*) AS rows, count(id) AS non_null_id FROM lance_feature.errs_empty_btier;
rows|non_null_id
0|0
(1 row)
-- A declaration that does match reads its zero rows, and count(*) asks for no
-- column at all, so it never had a projection to check.
CREATE FOREIGN TABLE lance_feature.errs_empty_ok (id integer, v text, n bigint)
  SERVER errs_files OPTIONS (uri 'empty.lance');
SELECT count(*) AS rows, count(v) AS non_null_v FROM lance_feature.errs_empty_ok;
rows|non_null_v
0|0
(1 row)
SELECT count(*) AS rows_coordinator FROM lance_feature.errs_empty_coord;
rows_coordinator
0
(1 row)
