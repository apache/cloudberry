SET lance_fdw.enable_vector_pushdown = off;
SELECT lance_feature.ids($$SELECT id FROM lance_feature.vec_nulls ORDER BY emb <-> '{1,0,0,0}' LIMIT 10$$) AS exact_10;
exact_10
