-- The column-based PAX CLUSTER rewrites tuples and rebuilds indexes.
-- Concurrent DML must wait until the rewrite and index rebuild finish.
CREATE EXTENSION IF NOT EXISTS gp_inject_fault;
CREATE
CREATE TABLE pax_cluster_lock (k int, v int) USING pax WITH (minmax_columns='k,v') DISTRIBUTED BY (k);
CREATE
ALTER TABLE pax_cluster_lock SET (cluster_columns='k,v');
ALTER
CREATE INDEX pax_cluster_lock_idx ON pax_cluster_lock(k);
CREATE
INSERT INTO pax_cluster_lock SELECT i, i FROM generate_series(1,1000) i ORDER BY (i*541)%1000;
INSERT 1000

-- Suspend the rewrite on one QE after the QD has acquired its table lock.
SELECT gp_inject_fault('orc_writer_write_tuple', 'suspend', '', '', '', 1, 1, 0, dbid) FROM gp_segment_configuration WHERE role='p' AND content=0;
 gp_inject_fault 
-----------------
 Success:        
(1 row)
1&: CLUSTER pax_cluster_lock;  <waiting ...>
SELECT gp_wait_until_triggered_fault('orc_writer_write_tuple', 1, dbid) FROM gp_segment_configuration WHERE role='p' AND content=0;
 gp_wait_until_triggered_fault 
-------------------------------
 Success:                      
(1 row)
2&: UPDATE pax_cluster_lock SET v=9999 WHERE k=42;  <waiting ...>
SELECT gp_inject_fault('orc_writer_write_tuple', 'reset', dbid) FROM gp_segment_configuration WHERE role='p' AND content=0;
 gp_inject_fault 
-----------------
 Success:        
(1 row)
1<:  <... completed>
CLUSTER
2<:  <... completed>
UPDATE 1

SET enable_seqscan=on;
SET
SET enable_indexscan=off;
SET
SET enable_bitmapscan=off;
SET
SELECT * FROM pax_cluster_lock WHERE k=42;
 k  | v    
----+------
 42 | 9999 
(1 row)
SET enable_seqscan=off;
SET
SET enable_indexscan=on;
SET
SET enable_bitmapscan=on;
SET
SELECT * FROM pax_cluster_lock WHERE k=42;
 k  | v    
----+------
 42 | 9999 
(1 row)
RESET enable_seqscan;
RESET
RESET enable_indexscan;
RESET
RESET enable_bitmapscan;
RESET

